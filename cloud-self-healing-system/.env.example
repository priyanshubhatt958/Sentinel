# Local Docker Compose settings. Replace the development database password before using shared environments.
POSTGRES_USER=cloud_user
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=cloud_self_healing

DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=5000

SIMULATION_MAX_DURATION_MS=60000
CPU_LOAD_PERCENT=70
MEMORY_LOAD_MB=100
DATABASE_DELAY_MS=300
DATABASE_QUERY_MULTIPLIER=5

AUTO_RECOVERY_ENABLED=false
AUTO_RECOVERY_MAX_ACTIONS_PER_HOUR=5
RECOVERY_COOLDOWN_MS=120000
MAX_RECOVERY_ACTIONS_PER_INCIDENT=3
MAX_RECOVERY_ACTIONS_PER_SERVICE_PER_HOUR=5
RECOVERY_MAX_FAILURES_BEFORE_MANUAL=3
RECOVERY_VERIFICATION_DELAY_MS=30000
RECOVERY_VERIFICATION_SAMPLES=6
MAX_SERVICE_REPLICAS=5
MIN_SERVICE_REPLICAS=1

GENAI_ENABLED=false
GENAI_API_KEY=
GENAI_API_URL=https://api.openai.com/v1/chat/completions
GENAI_MODEL=gpt-4o-mini

COMPOSE_PROJECT_NAME=cloud-self-healing-system
MONITORING_INTERVAL_MS=5000
MONITORING_PROBE_TIMEOUT_MS=3000
MONITORING_RETENTION_DAYS=7
